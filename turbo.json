{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "web#build": {
      "dependsOn": [],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "api#build": {
      "dependsOn": ["^build", "web#build"],
      "outputs": ["dist/**"]
    },
    "types": {
      "outputs": ["dist/types/**"]
    },
    "typecheck": {
      "dependsOn": ["^types"]
    },
    "lint": {
      "dependsOn": ["^types"]
    },
    "test": {
      "dependsOn": ["^types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
