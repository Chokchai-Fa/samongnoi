{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app-type": {
      "types": "./dist/types/app.d.ts"
    }
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist/worker",
    "types": "tsc -p tsconfig.types.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "eslint .",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@neondatabase/serverless": "1.2.0",
    "@repo/shared": "workspace:*",
    "@upstash/redis": "1.39.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@repo/config": "workspace:*",
    "@types/node": "^22.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
